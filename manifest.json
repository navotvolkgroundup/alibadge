{
  "manifest_version": 3,
  "name": "AliBadge",
  "version": "0.2.0",
  "description": "Finds the AliExpress listing a dropship store is reselling, and shows the markup.",
  "background": {
    "service_worker": "src/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "exclude_matches": [
        "*://*.aliexpress.com/*",
        "*://*.alicdn.com/*",
        "*://*.aliexpress-media.com/*"
      ],
      "js": [
        "src/receipt.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "permissions": [
    "storage",
    "clipboardWrite",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "aliexpress-origin",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}